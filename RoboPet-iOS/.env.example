# RoboPet Mac — no paid API key is required.
# Start with: bash start_mac.command
# Settings and pairing code are stored locally in .robopet_local.json
ROBO_PET_PORT=8765
# Ollama needs to be installed and running separately.
# Recommended smaller model: ollama pull qwen2.5:3b
# Optional offline voice recognition: python3 -m pip install faster-whisper
